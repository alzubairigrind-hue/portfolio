---
import { copy, type Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].howWeWork;
const digits = lang === 'ar' ? ['١', '٢', '٣', '٤', '٥'] : ['1', '2', '3', '4', '5'];
---

<section id="how" class="section" aria-labelledby="how-heading">
  <h2 id="how-heading" class="reveal">{t.heading}</h2>
  <ol class="steps">
    {
      t.steps.map((s, i) => (
        <li class="step reveal">
          <span class="num" aria-hidden="true">{digits[i]}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="commitments reveal" role="group" aria-labelledby="commit-heading">
    <h3 id="commit-heading" class="commit-title">{t.commitmentsHeading}</h3>
    <ul>
      {
        t.commitments.map((c) => (
          <li>
            <span class="tick" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="20" height="20"><path d="M4.5 10.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <div>
              <b>{c.title}</b>
              <p>{c.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // The path fills as the visitor scrolls, and each step lights up when the line reaches it.
  const steps = document.querySelector<HTMLElement>('.steps');
  if (steps) {
    const items = [...steps.querySelectorAll<HTMLElement>('.step')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const update = () => {
      const r = steps.getBoundingClientRect();
      const mid = innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      steps.style.setProperty('--p', p.toFixed(3));
      for (const it of items) {
        const n = it.querySelector('.num')!.getBoundingClientRect();
        it.classList.toggle('lit', n.top + n.height / 2 < mid);
      }
    };
    if (reduce) {
      steps.style.setProperty('--p', '1');
      items.forEach((i) => i.classList.add('lit'));
    } else {
      let ticking = false;
      addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        },
        { passive: true },
      );
      update();
    }
  }
</script>

<style>
  .steps { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: 1.9rem; max-inline-size: 46rem; }
  .steps::before,
  .steps::after { content: ''; position: absolute; inset-block: 1.3rem; inset-inline-start: calc(1.3rem - 1px); inline-size: 2px; border-radius: 2px; }
  .steps::before { background: var(--lilac-soft); }
  .steps::after { background: linear-gradient(var(--brand-2), var(--lilac)); transform-origin: top; scale: 1 var(--p, 1); }

  .step { position: relative; z-index: 1; display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; align-items: start; }
  .step h3 { margin: 0.35rem 0 0.2rem; }
  .num {
    display: grid;
    place-items: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--brand-2), var(--brand));
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    box-shadow: 0 10px 20px -12px rgb(43 20 99 / 0.7);
    transition: background-color 0.4s, color 0.4s, box-shadow 0.4s;
  }
  :global(.js) .step:not(.lit) .num { background: #fff; color: var(--brand); box-shadow: inset 0 0 0 2px var(--lilac-soft); }
  :global(.js) .step.lit .num { animation: lit 0.5s var(--spring); }
  @keyframes lit { 50% { scale: 1.18; } }

  .commitments { margin-block-start: 2rem; padding: clamp(1.5rem, 3vw, 2.25rem); border-radius: var(--radius-card); background: var(--hero-ground); color: var(--hero-ink); box-shadow: 0 30px 60px -36px rgb(43 20 99 / 0.8); }
  .commit-title { margin: 0 0 1.1rem; font-size: clamp(1.3rem, 2.4vw, 1.7rem); }
  .commitments ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .commitments li { display: grid; grid-template-columns: auto 1fr; gap: 0.75rem; align-items: start; }
  .commitments b { font-family: var(--font-heading); font-size: 1.05rem; }
  .commitments p { color: var(--hero-ink-2); }
  .tick { display: grid; place-items: center; inline-size: 2rem; block-size: 2rem; border-radius: 50%; background: #fff; color: var(--brand); }
</style>
