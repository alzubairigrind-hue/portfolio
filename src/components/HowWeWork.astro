---
import { copy, type Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang].howWeWork;
const chat = copy[lang].heroDemo;
const mark = lang === 'ar' ? 'ب' : 'B';
const digits = lang === 'ar' ? ['١', '٢', '٣', '٤', '٥'] : ['1', '2', '3', '4', '5'];
---

<section id="how" class="section" aria-labelledby="how-heading">
  <h2 id="how-heading" class="reveal">{t.heading}</h2>
  <ol class="steps">
    {
      t.steps.map((s, i) => (
        <li class="step reveal">
          <span class="num" aria-hidden="true">{digits[i]}</span>
          <div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <!-- Round 7A: the commitments arrive as messages from Bin Mahyub, since the written price really is sent on WhatsApp. -->
  <div class="commitments" role="group" aria-labelledby="commit-heading">
    <h3 id="commit-heading" class="commit-title reveal">{t.commitmentsHeading}</h3>
    <div class="thread reveal">
      <div class="thread__top">
        <span class="avatar" aria-hidden="true">{mark}</span>
        <b>{chat.contact}</b>
      </div>
      <ul class="thread__body">
        {
          t.commitments.map((c, i) => (
            <li class="bubble reveal">
              <b>{c.title}</b>
              <p>{c.body}</p>
              <span class="meta" aria-hidden="true">
                {i === 0 && <span class="chip">{chat.messages[1].chip}</span>}
                <svg class="ticks" viewBox="0 0 24 16" width="20" height="14"><path d="M1.5 8.5l4 4L14 3.5M9.5 12.5L18.5 3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // The path fills as the visitor scrolls, and each step lights up when the line reaches it.
  const steps = document.querySelector<HTMLElement>('.steps');
  if (steps) {
    const items = [...steps.querySelectorAll<HTMLElement>('.step')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const update = () => {
      const r = steps.getBoundingClientRect();
      const mid = innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      steps.style.setProperty('--p', p.toFixed(3));
      for (const it of items) {
        const n = it.querySelector('.num')!.getBoundingClientRect();
        it.classList.toggle('lit', n.top + n.height / 2 < mid);
      }
    };
    if (reduce) {
      steps.style.setProperty('--p', '1');
      items.forEach((i) => i.classList.add('lit'));
    } else {
      let ticking = false;
      addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        },
        { passive: true },
      );
      update();
    }
  }
</script>

<style>
  .steps { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: 1.9rem; max-inline-size: 46rem; }
  .steps::before,
  .steps::after { content: ''; position: absolute; inset-block: 1.3rem; inset-inline-start: calc(1.3rem - 1px); inline-size: 2px; border-radius: 2px; }
  .steps::before { background: var(--lilac-soft); }
  .steps::after { background: linear-gradient(var(--brand-2), var(--lilac)); transform-origin: top; scale: 1 var(--p, 1); }

  .step { position: relative; z-index: 1; display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; align-items: start; }
  .step h3 { margin: 0.35rem 0 0.2rem; }
  .num {
    display: grid;
    place-items: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--brand-2), var(--brand));
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    box-shadow: 0 10px 20px -12px rgb(43 20 99 / 0.7);
    transition: background-color 0.4s, color 0.4s, box-shadow 0.4s;
  }
  :global(.js) .step:not(.lit) .num { background: #fff; color: var(--brand); box-shadow: inset 0 0 0 2px var(--lilac-soft); }
  :global(.js) .step.lit .num { animation: lit 0.5s var(--spring); }
  @keyframes lit { 50% { scale: 1.18; } }

  /* A light chat window, the hero phone's colours, so it no longer twins the dark contact panel. */
  .commitments { display: grid; gap: 1.1rem; margin-block-start: 2rem; }
  .commit-title { margin: 0; font-size: clamp(1.3rem, 2.4vw, 1.7rem); }
  .thread { max-inline-size: 46rem; border-radius: var(--radius-card); background: #f3f0fb; padding: 10px; box-shadow: 0 30px 60px -36px rgb(43 20 99 / 0.55); }
  .thread__top { display: flex; align-items: center; gap: 0.7rem; padding: 0.75rem 1rem; background: #fff; border-radius: 22px 22px 10px 10px; }
  .avatar { flex: none; display: grid; place-items: center; inline-size: 2.2rem; block-size: 2.2rem; border-radius: 30%; background: var(--brand); color: #fff; font-family: var(--font-heading); font-weight: 900; }
  .thread__body { list-style: none; margin: 0; padding: 1.1rem 0.6rem 0.8rem; display: grid; gap: 0.75rem; }
  /* Incoming messages sit on the start side, as Bin Mahyub's do in the hero chat. */
  .bubble { justify-self: start; max-inline-size: 86%; padding: 0.8rem 1rem 0.5rem; background: #fff; border-radius: 18px; border-start-start-radius: 4px; box-shadow: 0 2px 8px -4px rgb(0 0 0 / 0.2); }
  .bubble b { font-family: var(--font-heading); font-size: 1.05rem; color: var(--brand); }
  .meta { display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; margin-block-start: 0.25rem; }
  .chip { padding: 0.1rem 0.7rem; border-radius: var(--radius-pill); background: var(--brand); color: #fff; font-size: 0.78rem; font-weight: 700; }
  .ticks { color: var(--brand-2); }
  /* The bubbles arrive one after another, like messages. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .bubble.reveal:not(.in) { translate: 0 18px; scale: 0.94; }
    :global(.js) .bubble.reveal:nth-child(2) { transition-delay: 0.35s; }
    :global(.js) .bubble.reveal:nth-child(3) { transition-delay: 0.7s; }
  }
</style>
