---
import { copy, type Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const [landing, store, care] = t.services.items;
const cartCount = lang === 'ar' ? '٢' : '2';
---

<section id="services" class="section" aria-labelledby="services-heading">
  <h2 id="services-heading" class="reveal">{t.services.heading}</h2>
  <ol class="grid">
    <li class="card reveal">
      <div class="art" aria-hidden="true">
        <div class="d-phone"><span class="d-line"></span><span class="d-line short"></span><span class="d-btn"></span></div>
      </div>
      <h3>{landing.title}</h3>
      <p>{landing.body}</p>
    </li>
    <li class="card reveal">
      <div class="art" aria-hidden="true">
        <div class="d-store">
          <span class="d-cart">{cartCount}</span>
          <span class="d-item"></span><span class="d-item"></span><span class="d-item"></span><span class="d-item"></span>
        </div>
      </div>
      <h3>{store.title}</h3>
      <p>{store.body}</p>
    </li>
    <li class="card reveal">
      <div class="art" aria-hidden="true">
        <div class="d-shield">
          <svg viewBox="0 0 80 90" width="80" height="90"><path d="M40 6l28 10v22c0 20-12 36-28 44C24 74 12 58 12 38V16z" fill="#2b1463" /><path d="M29 45l8 8 15-17" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          <span class="d-ring"></span>
        </div>
      </div>
      <h3>{care.title}</h3>
      <p>{care.body}</p>
    </li>
  </ol>
</section>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .card { padding: 1.5rem 1.75rem 1.75rem; }
  .art { display: grid; place-items: center; block-size: 150px; margin-block-end: 1rem; border-radius: 20px; background: linear-gradient(160deg, #ece6ff, #f8f6ff); overflow: hidden; }

  .d-phone { inline-size: 70px; block-size: 120px; border-radius: 16px; background: #fff; border: 3px solid var(--brand); padding: 12px 10px; display: grid; align-content: start; gap: 7px; box-shadow: 0 14px 26px -14px rgb(43 20 99 / 0.6); animation: bob 3s ease-in-out infinite; }
  .d-line { display: block; block-size: 6px; border-radius: 9px; background: #e3dcfb; }
  .d-line.short { inline-size: 60%; }
  .d-btn { display: block; margin-block-start: 18px; block-size: 14px; border-radius: 9px; background: var(--brand); animation: pulse 1.8s ease-in-out infinite; }

  .d-store { position: relative; display: grid; grid-template-columns: repeat(2, 42px); gap: 8px; padding: 14px; border-radius: 16px; background: #fff; box-shadow: 0 14px 26px -14px rgb(43 20 99 / 0.6); }
  .d-item { block-size: 34px; border-radius: 10px; background: linear-gradient(140deg, #ffb26b, #ff7ac6); }
  .d-item:nth-child(3) { background: linear-gradient(140deg, #b69cff, #7b5cff); }
  .d-item:nth-child(4) { background: linear-gradient(140deg, #7ee0c3, #3ec4a0); }
  .d-cart { position: absolute; inset-block-start: -10px; inset-inline-end: -10px; display: grid; place-items: center; inline-size: 26px; block-size: 26px; border-radius: 50%; background: var(--brand); color: #fff; font-size: 0.8rem; font-weight: 800; animation: bounce 1.6s var(--spring) infinite; }

  .d-shield { position: relative; display: grid; place-items: center; }
  .d-ring { position: absolute; inline-size: 118px; block-size: 118px; border-radius: 50%; border: 3px dashed var(--lilac); animation: spin 8s linear infinite; }

  @keyframes bob { 50% { translate: 0 -8px; } }
  @keyframes pulse { 50% { opacity: 0.55; scale: 0.94; } }
  @keyframes bounce { 0%, 60%, 100% { scale: 1; } 30% { scale: 1.25; } }
  @keyframes spin { to { rotate: 360deg; } }
</style>
