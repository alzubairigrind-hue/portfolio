---
import { copy, type Lang, type Project } from '../content/copy';

interface Props {
  lang: Lang;
  project: Project;
}

const { lang, project } = Astro.props;
---

<article class="browser reveal">
  <div class="bar">
    <i></i><i></i><i></i>
    {project.status === 'coming-soon' && <span class="badge">{project.statusLabel[lang]}</span>}
  </div>
  <div class="preview" aria-hidden="true"><span class="preview__bar preview__bar--wide"></span><span class="preview__bar preview__bar--short"></span><span class="preview__pill"></span></div>
  <div class="body">
    <h3>{project.name[lang]}</h3>
    <p>{project.description[lang]}</p>
    {
      (project.status === 'live' || project.repoUrl) && (
        <div class="links">
          {project.status === 'live' && <a class="btn btn--brand" href={`/work/${project.slug}/`} target="_blank" rel="noopener">{copy[lang].work.demoLabel}</a>}
          {project.repoUrl && <a class="link" href={project.repoUrl} target="_blank" rel="noopener">GitHub</a>}
        </div>
      )
    }
  </div>
</article>

<style>
  .browser { border-radius: 22px; overflow: hidden; background: #fff; border: 1px solid var(--card-line); box-shadow: 0 30px 60px -36px rgb(43 20 99 / 0.55); }
  .bar { display: flex; align-items: center; gap: 6px; padding: 0.7rem 1rem; background: #f1eefa; }
  .bar i { inline-size: 10px; block-size: 10px; border-radius: 50%; background: #cfc6ea; }
  .badge { margin-inline-start: auto; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.85rem; border-radius: var(--radius-pill); background: #fff; border: 1px dashed var(--lilac); color: var(--brand); font-size: 0.8rem; font-weight: 700; }
  .badge::before { content: ''; inline-size: 0.5rem; block-size: 0.5rem; border-radius: 50%; background: var(--lilac); }
  .body { padding: 1.5rem 1.75rem 1.75rem; display: grid; gap: 0.5rem; }
  .body h3 { margin: 0; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-block-start: 0.5rem; }
  .link { font-weight: 700; }
  /* An abstract drawn preview, never a screenshot: the project stays honestly "coming soon". */
  .preview { block-size: 120px; margin-block-start: 1.5rem; margin-inline: 1.75rem; padding: 1.25rem; display: grid; align-content: center; gap: 0.75rem; border-radius: 16px; background: linear-gradient(160deg, #ece6ff, #f8f6ff); }
  .preview__bar { display: block; block-size: 8px; border-radius: 99px; background: #ddd2ff; }
  .preview__bar--wide { inline-size: 70%; }
  .preview__bar--short { inline-size: 45%; }
  .preview__pill { display: block; inline-size: 64px; block-size: 16px; border-radius: 999px; background: var(--brand); }
</style>
