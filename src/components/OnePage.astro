---
import Base from '../layouts/Base.astro';
import { copy } from '../content/copy';
import Hero from './Hero.astro';
import About from './About.astro';
import Services from './Services.astro';
import HowWeWork from './HowWeWork.astro';
import Work from './Work.astro';
import Contact from './Contact.astro';
import SiteFooter from './SiteFooter.astro';
import type { Lang } from '../shared/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<Base lang={lang} title={t.meta.title} description={t.meta.description}>
  <Hero lang={lang} />
  <main>
    <About lang={lang} />
    <Services lang={lang} />
    <!-- Work before How-we-work: the commitments (trust peak) run straight into the ask. -->
    <Work lang={lang} />
    <HowWeWork lang={lang} />
    <Contact lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</Base>
