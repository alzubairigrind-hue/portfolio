---
import { copy, type Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<section id="about" class="section" aria-labelledby="about-statement">
  <h2 id="about-statement" class="statement reveal">{t.about.lead}</h2>
  <p class="body reveal"><span class="since">{t.about.since}</span> {t.about.body}</p>
</section>

<style>
  .statement { font-family: var(--font-heading); font-weight: 800; font-size: clamp(1.6rem, 3.2vw, 2.6rem); line-height: 1.45; color: var(--brand); max-inline-size: 20ch; text-wrap: balance; }
  :global(html[lang='en']) .statement { max-inline-size: 26ch; line-height: 1.3; }
  .body { line-height: 2.1; }
  /* The pill opens the sentence, so it stays inline and never breaks apart. */
  .since { display: inline-block; white-space: nowrap; margin-inline-end: 0.15rem; padding: 0.1rem 0.85rem; border-radius: var(--radius-pill); background: linear-gradient(180deg, var(--brand-2), var(--brand)); color: #fff; font-family: var(--font-heading); font-weight: 800; line-height: 1.7; box-shadow: 0 8px 16px -10px rgb(43 20 99 / 0.7); }
</style>
