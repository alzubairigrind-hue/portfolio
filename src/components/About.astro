---
import { copy, type Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<section id="about" class="section" aria-labelledby="about-heading">
  <h2 id="about-heading" class="reveal">{t.about.heading}</h2>
  <p class="statement reveal">{t.about.lead}</p>
  <div class="row reveal">
    <span class="since">{t.about.since}</span>
    <p>{t.about.body}</p>
  </div>
</section>

<style>
  .statement { font-family: var(--font-heading); font-weight: 800; font-size: clamp(1.6rem, 3.2vw, 2.6rem); line-height: 1.45; color: var(--brand); max-inline-size: 20ch; text-wrap: balance; }
  :global(html[lang='en']) .statement { max-inline-size: 26ch; line-height: 1.3; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .since { flex: none; padding: 0.4rem 1rem; border-radius: var(--radius-pill); background: linear-gradient(180deg, var(--brand-2), var(--brand)); color: #fff; font-family: var(--font-heading); font-weight: 800; box-shadow: 0 10px 20px -12px rgb(43 20 99 / 0.7); }
</style>
