---
import { copy, type Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const isAr = lang === 'ar';
---

<footer>
  <p>{t.footer.copyright}</p>
  {
    isAr ? (
      <a href="/en/" lang="en" hreflang="en">{t.footer.switchLabel}</a>
    ) : (
      <a href="/" lang="ar" hreflang="ar" dir="rtl">{t.footer.switchLabel}</a>
    )
  }
</footer>