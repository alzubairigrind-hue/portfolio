---
import { copy, type Lang } from '../content/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<footer>
  <p>{t.footer.copyright}</p>
</footer>

<style>
  footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; max-inline-size: 72rem; margin-inline: auto; padding: 2rem var(--pad) 3rem; color: var(--ink-2); font-size: 0.9rem; }
</style>
