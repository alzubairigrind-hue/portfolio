---
import { copy, projects, type Lang } from '../content/copy';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
---

<section id="work" class="section" aria-labelledby="work-heading">
  <h2 id="work-heading" class="reveal">{t.work.heading}</h2>
  <div class="grid">
    {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
  </div>
</section>

<style>
  /* auto-fit collapses empty tracks: one project spans the full row, and 3–5 still wrap into columns. */
  .grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }
</style>
